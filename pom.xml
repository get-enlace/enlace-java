<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.get-enlace</groupId>
    <artifactId>enlace-spring-boot-starter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>enlace-spring-boot-starter</name>
    <description>Spring Boot starter for Enlace — a visual, chained-execution canvas for OpenAPI APIs</description>
    <url>https://github.com/get-enlace/enlace-java</url>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/get-enlace/enlace-java</url>
        <connection>scm:git:git://github.com/get-enlace/enlace-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/get-enlace/enlace-java.git</developerConnection>
    </scm>

    <!-- Required by Maven Central's publishing validation, alongside name/description/url/
         licenses/scm above — a component missing any of these is rejected at upload. -->
    <developers>
        <developer>
            <id>BugDiver</id>
            <name>BugDiver</name>
            <!-- GitHub's noreply alias, not a personal address — this pom.xml ends up
                 permanently mirrored on Maven Central once published. -->
            <email>15309877+BugDiver@users.noreply.github.com</email>
            <url>https://github.com/BugDiver</url>
        </developer>
    </developers>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.4.1</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- IDE metadata for enlace.* properties (additional-spring-configuration-metadata.json
             equivalent, generated automatically) — not required at runtime. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/get-enlace/enlace-java</url>
        </repository>
    </distributionManagement>

    <!--
        Activated only by deploy-prod (`mvn deploy -Prelease`), never by a plain build —
        Maven Central requires every artifact GPG-signed plus sources/javadoc jars attached,
        none of which a contributor running `mvn test`/`mvn install` locally should need a
        GPG key for. deploy-dev (GitHub Packages) doesn't activate this profile: it deploys
        through the plain `distributionManagement` block above instead.

        Unlike NuGet's/PyPI's GitHub Actions OIDC trusted publishing (see enlace-dotnet's and
        enlace-python's CI/CD docs), Maven Central has no equivalent as of this writing —
        publishing here still needs a real GPG keypair and a Central Portal user token, both
        as GitHub secrets. See CONTRIBUTING.md's "One-time setup this needs" for exactly what.
        This profile is authored and buildable locally, and has been verified end to end
        against a real Central Portal account (deploy-prod's first live run) — it initially
        failed with a 401 against the `github` distributionManagement repo above, because
        central-publishing-maven-plugin's `<extensions>true</extensions>` does NOT, as its own
        docs can read as implying, replace maven-deploy-plugin's own `deploy`-phase execution —
        both stay bound to the same phase, so the plain deploy-plugin still tried (and failed)
        to resolve remote metadata from `github` using credentials this profile never
        configures for that server id. Skipping maven-deploy-plugin below, only within this
        profile, is what actually makes central-publishing-maven-plugin the sole thing
        deploying when `-Prelease` is active.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Sonatype's official Central Portal publisher, bound to the `deploy`
                         phase like maven-deploy-plugin below — declaring it here does NOT by
                         itself stop the plain deploy-plugin from also running against
                         distributionManagement (confirmed the hard way: see the block comment
                         above this profile). Skipping that plugin, just below, is what makes
                         this the only thing that actually deploys when -Prelease is active. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <!-- Prevents the standard deploy-plugin execution (bound to the same
                         `deploy` phase) from also running against distributionManagement's
                         `github` repo — this profile never configures credentials for that
                         server id, so left unskipped it 401s trying to resolve remote
                         metadata there before central-publishing-maven-plugin's own execution
                         even runs. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
